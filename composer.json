{
    "name": "componenta/serialize-interceptor",
    "description": "Symfony Serializer result interceptor for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/interceptor": "^2.0@dev",
        "symfony/serializer": "^7.4 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Interceptor\\Serialization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Interceptor\\Serialization\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    },
    "prefer-stable": true
}
