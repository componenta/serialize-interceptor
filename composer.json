{
    "name": "componenta/serialize-interceptor",
    "description": "Symfony Serializer result interceptor for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5.13",
        "componenta/interceptor": "^4.0",
        "symfony/serializer": "^8.1"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.3",
        "componenta/di": "^6.0",
        "componenta/config": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Interceptor\\Serialization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Interceptor\\Serialization\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "analyse": "@php vendor/bin/phpstan analyse src tests/StaticAnalysis --level=max"
    },
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev",
            "dev-spec/attribute-callbacks-2026-11-26": "2.0.x-dev"
        }
    }
}
