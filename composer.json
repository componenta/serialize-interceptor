{
    "name": "componenta/serialize-interceptor",
    "description": "Symfony Serializer result interceptor for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/interceptor": "^3.0.0",
        "symfony/serializer": "^7.4 || ^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "componenta/di": "^5.0.0",
        "componenta/config": "^3.0.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Interceptor\\Serialization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Interceptor\\Serialization\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest"
    },
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
